#!/usr/bin/env bash

cd -- "$HOME/Pictures/Wallpapers" || exit 1
shopt -s nullglob nocaseglob

wallpapers() {
    local file icon
    for file in *.jpg *.png *.jpeg *.mp4; do
        [[ -f $file ]] || continue
        icon="$PWD/$file"
        if [[ ${file,,} == *.mp4 ]]; then
            icon="thumbnail://$icon"
        fi
        printf '%s\0icon\x1f%s\n' "$file" "$icon"
    done
}

selected=$(wallpapers | rofi -dmenu -p "Select" \
    -theme "$HOME/.local/share/rofi/themes/expanded-grid.rasi") || exit 0
[[ -n $selected ]] || exit 0
exec walset-backend "$selected"
